# SmileWorks Solutions — environment variables
# Copy to `.env.local` (Next.js) and `.env` (Prisma CLI) and fill in values.
# NEVER commit real secrets. Only NEXT_PUBLIC_* values are sent to the browser,
# so they must never contain secrets.

# --- Public (browser-visible) --------------------------------------------------
# Canonical production URL — used for metadataBase, canonical URLs, sitemap,
# Open Graph and the allowed origin for the enquiry endpoint.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Verified public contact details. Leave blank to hide them on the site.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
# Genuine booking link (https only), e.g. a Calendly page. Leave blank to hide.
NEXT_PUBLIC_BOOKING_URL=

# Cloudflare Turnstile site key (optional; requires TURNSTILE_SECRET_KEY too).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- Server-only secrets -------------------------------------------------------
# PostgreSQL connection string. When set, enquiries are stored and rate limits
# are shared across instances. Use a least-privilege database user.
DATABASE_URL=

# Resend (https://resend.com) — enquiry notification emails.
RESEND_API_KEY=
# Comma-separated list of internal recipients.
CONTACT_NOTIFICATION_EMAIL=
# Sender on a domain verified in Resend, e.g. "SmileWorks Website <website@yourdomain.com>".
CONTACT_FROM_EMAIL=

# Cloudflare Turnstile secret (optional).
TURNSTILE_SECRET_KEY=

# Random secret (32+ chars) used to hash IPs/emails for rate limiting.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RATE_LIMIT_SALT=

# Set to "true" ONLY when deployed behind a reverse proxy/CDN that overwrites
# X-Forwarded-For / X-Forwarded-Host / X-Forwarded-Proto (e.g. Vercel, a
# correctly configured Nginx). Leave "false" otherwise.
TRUST_PROXY_HEADERS=false

# Extra origins allowed to POST to /api/consultation (comma-separated),
# e.g. a preview domain. The NEXT_PUBLIC_SITE_URL origin is always allowed.
ALLOWED_ORIGINS=
